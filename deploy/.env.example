# Mercatai self-host configuration — copy to .env and fill in.
# Generate secrets with: openssl rand -hex 32

# PostgreSQL superuser password (local container only)
POSTGRES_PASSWORD=

# PostgREST JWT secret. The SUPABASE_SERVICE_ROLE_KEY below must be a JWT
# signed with this secret — see docs/self-hosting.md §3 for the one-liner.
PGRST_JWT_SECRET=

# JWT with {"role":"service_role"} signed with PGRST_JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=

# App JWT signing key (agent/buyer tokens)
JWT_SECRET_KEY=

# Stripe secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# Stripe publishable key (pk_live_... or pk_test_...) — served to the browser
# so the Payment Element can mount. Without it buyers cannot pay.
STRIPE_PUBLISHABLE_KEY=

# Signing secret of the payment webhook endpoint you register at
# https://your-domain/api/v1/payments/stripe-webhook (Stripe Dashboard →
# Developers → Webhooks). Endpoint-specific, starts with whsec_.
STRIPE_WEBHOOK_SECRET=

# Signing secret of the SEPARATE Connect webhook endpoint you register at
# https://your-domain/api/v1/payments/stripe-connect-webhook, subscribed
# to events "on connected accounts" (account.updated, payout.created,
# payout.updated, payout.paid, payout.failed). This is a distinct Stripe
# event destination from the one above and can have its own signing
# secret — do not reuse STRIPE_WEBHOOK_SECRET here. Without this set, that
# endpoint answers 503 and Mercatai has no visibility into an agent's
# Stripe account losing payout readiness or a payout to their bank
# account failing. See docs/self-hosting.md §6.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Comma-separated ISO 3166-1 alpha-2 country codes this Stripe platform
# account actually has enabled for Connect onboarding (Stripe Dashboard →
# Settings → Connect → Onboarding options → Countries) — check that page
# before adding a code here, since Stripe documenting a country as
# Express-capable does not mean this specific platform account has it
# turned on. Leave empty (or unset) and Mercatai falls back to the
# conservative default CZ,DE,NO rather than the full ~100-country catalog
# in frontend/lib/onboardingCountries.ts. See
# docs/stripe-connect-country-support.md.
STRIPE_CONNECT_ENABLED_COUNTRIES=CZ,DE,NO

# Shared secret protecting the /api/cron/* endpoints
CRON_SECRET=

# Password for the /admin back-office (leave empty to disable admin login)
ADMIN_PASSWORD=

# Optional: transactional email (bid notifications). Leave empty to disable.
RESEND_API_KEY=

# Optional: where moderation and Stripe payout-failure alerts are sent
# (see frontend/lib/server/email.ts). Leave empty and those alerts are
# only logged to the app's own console output, not emailed to anyone.
ADMIN_ALERT_EMAIL=

# Public URL of this deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_PORT=3000
