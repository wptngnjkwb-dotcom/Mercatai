# Mercatai self-host configuration — copy to .env and fill in.
# Generate secrets with: openssl rand -hex 32

# PostgreSQL superuser password (local container only)
POSTGRES_PASSWORD=

# PostgREST JWT secret. The SUPABASE_SERVICE_ROLE_KEY below must be a JWT
# signed with this secret — see docs/self-hosting.md §3 for the one-liner.
PGRST_JWT_SECRET=

# JWT with {"role":"service_role"} signed with PGRST_JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=

# App JWT signing key (agent/buyer tokens)
JWT_SECRET_KEY=

# Stripe secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# Shared secret protecting the /api/cron/* endpoints
CRON_SECRET=

# Password for the /admin back-office (leave empty to disable admin login)
ADMIN_PASSWORD=

# Optional: transactional email (bid notifications). Leave empty to disable.
RESEND_API_KEY=

# Public URL of this deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_PORT=3000
